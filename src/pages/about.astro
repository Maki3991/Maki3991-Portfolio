---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { aboutEntry } from "@/data/about";
import "@/styles/secondary-pages.css";
import "@/styles/now-content.css";
import "@/styles/display-title.css";
---

<BaseLayout title="关于" description="关于 Maki 羽轩：国际政治本科生、英语内容创作者和长期学习者。">
  <section class="page-hero about-page">
    <p class="eyebrow">WORKING CONTEXT</p>
    <h1 class="display-title">About</h1>
    <p class="page-hero-subtitle">把经历变成方法</p>
  </section>

  <section class="section about-article">
    {aboutEntry ? (
      <article class="now-entry-content about-prose" set:html={aboutEntry.html}></article>
    ) : (
      <p class="now-empty">About 内容正在整理。</p>
    )}
  </section>
</BaseLayout>
