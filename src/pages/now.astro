---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/now.css";
import "@/styles/display-title.css";
---

<BaseLayout
  title="Now"
  description="Maki 羽轩当前正在关注的事情和工作阶段。"
>
  <div class="now-page">
    <section class="now-shell" aria-labelledby="now-title">
      <p class="now-kicker">NOW / CURRENT PHASE</p>
      <h1 id="now-title" class="display-title">Now</h1>
      <p class="now-intro">
        这个页面正在整理。当前正在做的事情，先记录在 Home 的 Current Workbench 和 Archive 中。
      </p>
      <a class="now-back-link" href="/">回到 Home ↗</a>
    </section>
  </div>
</BaseLayout>
