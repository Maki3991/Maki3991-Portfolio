---
import SectionIntro from "@/components/SectionIntro.astro";
import WorkCard from "@/components/WorkCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { proofs, workCategories, works } from "@/data/site";
---

<BaseLayout title="作品" description="Maki 羽轩的代表作品、内容复盘、英语产品交付与未来作品档案。">
  <section class="page-hero">
    <p class="eyebrow">Works</p>
    <h1>作品集</h1>
    <p>这里按领域整理作品，而不是只按平台分类。第一版先放可维护结构，真实链接和截图会继续补齐。</p>
  </section>

  {
    workCategories.map((category, index) => {
      const categoryWorks = works.filter((work) => work.category === category);
      return (
        <details class="category-toggle" id={category} open={index === 0}>
          <summary>
            <span>{category}</span>
            <small>{categoryWorks.length} 个作品</small>
          </summary>
          <div class="category-toggle-body">
            {categoryWorks.length > 0 ? (
              <div class="card-grid two">
                {categoryWorks.map((work) => <WorkCard work={work} />)}
              </div>
            ) : (
              <div class="empty-state">
                <strong>待补充</strong>
                <p>这个领域会在后续加入真实作品、链接、截图和复盘。</p>
              </div>
            )}
          </div>
        </details>
      );
    })
  }

  <section class="section category-section">
    <SectionIntro
      eyebrow="Proof"
      title="数据与证明材料"
      body="这里不堆满所有后台截图，只放最能支撑账号表现的证明材料。"
    />
    <div class="proof-grid">
      {
        proofs.map((proof) => (
          <article class="proof-card">
            <img src={proof.image} alt={proof.title} loading="lazy" />
            <div>
              <h3>{proof.title}</h3>
              <p>{proof.note}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
