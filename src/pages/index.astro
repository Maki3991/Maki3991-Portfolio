---
import ProjectCard from "@/components/ProjectCard.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import StatGrid from "@/components/StatGrid.astro";
import WorkCard from "@/components/WorkCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile, projects, stats, works } from "@/data/site";
---

<BaseLayout title="Maki 羽轩" description="Maki 羽轩的个人作品集：英语内容、自媒体运营、英语产品交付与 AI 辅助创作。">
  <section class="hero">
    <div class="hero-copy">
      <h1>{profile.name}</h1>
      <p class="headline">{profile.headline}</p>
      <p>{profile.intro}</p>
      <div class="button-row">
        <a class="button primary" href="/works/">查看代表作品</a>
        <a class="button" href="/projects/">查看项目经历</a>
        <a class="button ghost" href="/contact/">联系我</a>
      </div>
    </div>
    <aside class="portrait-panel" aria-label="Maki 羽轩头像">
      <img src="/assets/profile/maki-avatar.jpg" alt="Maki 羽轩头像" />
    </aside>
  </section>

  <section class="section">
    <SectionIntro
      title="这些数字不是榜单，是内容操盘的证据。"
    />
    <StatGrid stats={stats} />
  </section>

  <section class="section">
    <SectionIntro title="我正在长期投入的三件事" />
    <div class="card-grid three">
      {projects.map((project) => <ProjectCard project={project} compact />)}
    </div>
  </section>

  <section class="section">
    <SectionIntro title="先呈现结构，再持续补证据" />
    <div class="card-grid two">
      {works.slice(0, 6).map((work) => <WorkCard work={work} />)}
    </div>
  </section>
</BaseLayout>
