---
import ProjectCard from "@/components/ProjectCard.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import StatGrid from "@/components/StatGrid.astro";
import WorkCard from "@/components/WorkCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile, projects, stats, works, type Work } from "@/data/site";

const featuredWorks = [
  "四级六级听力吐槽与学习路径内容",
  "40 天 四六级 如何阅读满分 一把过？",
  "一个大二文科生思考：张雪峰“文科大有前途”",
].map((title) => works.find((work) => work.title === title)).filter((work): work is Work => Boolean(work));
---

<BaseLayout title="Maki 羽轩" description="Maki 羽轩的个人作品集：英语内容、自媒体运营、英语产品交付与 AI 辅助创作。">
  <section class="hero">
    <div class="hero-copy">
      <h1>{profile.name}</h1>
      <p class="headline">{profile.headline}</p>
      <p>{profile.intro}</p>
      <div class="button-row">
        <a class="button primary" href="/works/">查看代表作品</a>
        <a class="button" href="/projects/">查看项目经历</a>
        <a class="button ghost" href="/contact/">联系我</a>
      </div>
    </div>
    <aside class="portrait-panel" aria-label="Maki 羽轩头像">
      <img src="/assets/profile/maki-avatar.jpg" alt="Maki 羽轩头像" />
    </aside>
  </section>

  <section class="section">
    <SectionIntro
      title="这些数字不是榜单，是内容操盘的证据。"
    />
    <StatGrid stats={stats} />
  </section>

  <section class="section">
    <SectionIntro title="我正在长期投入的三件事" />
    <div class="card-grid three">
      {projects.map((project) => <ProjectCard project={project} compact />)}
    </div>
  </section>

  <section class="section">
    <SectionIntro title="精选作品" />
    <div class="card-grid three">
      {featuredWorks.map((work) => <WorkCard work={work} />)}
    </div>
    <div class="section-action">
      <a class="button" href="/works/">查看完整作品集</a>
    </div>
  </section>
</BaseLayout>
