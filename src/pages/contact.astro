---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { links } from "@/data/site";

const isExternalLink = (href: string) => href.startsWith("http");
---

<BaseLayout title="联系" description="联系 Maki 羽轩，查看账号主页、简历和作品集入口。">
  <section class="page-hero">
    <p class="eyebrow">Contact</p>
    <h1>联系我</h1>
  </section>

  <section class="section contact-layout">
    <div class="qr-placeholder">
      <img class="contact-avatar" src="/assets/profile/maki-avatar.jpg" alt="Maki 羽轩头像" />
      <img src="/assets/contact/wechat.jpg" alt="微信二维码" />
      <span>微信二维码</span>
    </div>
    <div class="link-list">
      {
        links.map((link) => (
          <article
            class:list={["contact-link", link.status === "placeholder" && "pending"]}
          >
            <a
              class="contact-link-main"
              href={link.href}
              aria-label={isExternalLink(link.href) ? link.label + " (external link)" : link.label}
              target={isExternalLink(link.href) ? "_blank" : undefined}
              rel={isExternalLink(link.href) ? "noreferrer" : undefined}
            >
              <span>
                {link.label}
                {isExternalLink(link.href) && (
                  <span class="contact-link-external" aria-hidden="true"> ↗</span>
                )}
              </span>
              <small>{link.note}</small>
            </a>
            {
              link.image && (
                <button class="qr-zoom-trigger" type="button" data-qr={link.image} data-label={link.label}>
                  <img src={link.image} alt={`${link.label}二维码`} loading="lazy" />
                </button>
              )
            }
          </article>
        ))
      }
    </div>
  </section>

  <dialog class="qr-dialog" aria-label="二维码预览">
    <button class="qr-dialog-close" type="button" aria-label="关闭">关闭</button>
    <img src="" alt="" />
  </dialog>

  <script>
    const dialog = document.querySelector(".qr-dialog");
    const dialogImage = dialog?.querySelector("img");
    const closeButton = dialog?.querySelector(".qr-dialog-close");

    document.querySelectorAll(".qr-zoom-trigger").forEach((button) => {
      button.addEventListener("click", () => {
        if (!(dialog instanceof HTMLDialogElement) || !dialogImage) return;
        const image = button.getAttribute("data-qr");
        const label = button.getAttribute("data-label") || "二维码";
        if (!image) return;
        dialogImage.setAttribute("src", image);
        dialogImage.setAttribute("alt", `${label}二维码`);
        dialog.showModal();
      });
    });

    closeButton?.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });

    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
    });
  </script>
</BaseLayout>
