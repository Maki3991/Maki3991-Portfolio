---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { links } from "@/data/site";
---

<BaseLayout title="联系" description="联系 Maki 羽轩，查看账号主页、简历和作品集入口。">
  <section class="page-hero">
    <p class="eyebrow">Contact</p>
    <h1>联系我</h1>
    <p>如果你对内容运营、英语教育产品、AI 辅助创作或学习系统感兴趣，欢迎联系我。</p>
  </section>

  <section class="section contact-layout">
    <div class="qr-placeholder">
      <img class="contact-avatar" src="/assets/profile/maki-avatar.jpg" alt="Maki 羽轩头像" />
      <img src="/assets/contact/wechat.jpg" alt="微信二维码" />
      <span>微信二维码</span>
      <p>扫码添加微信，或通过邮箱联系我。</p>
    </div>
    <div class="link-list">
      {
        links.map((link) => (
          <a
            class:list={["contact-link", link.status === "placeholder" && "pending"]}
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          >
            <span>{link.label}</span>
            <small>{link.note}</small>
            {link.image && <img src={link.image} alt={`${link.label}二维码`} loading="lazy" />}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
