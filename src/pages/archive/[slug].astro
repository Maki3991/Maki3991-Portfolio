---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  archiveItems,
  type ArchiveEvidence,
  type ArchiveItemWithBody,
  type ArchiveType,
} from "@/data/archive";
import "@/styles/archive-detail.css";

type Props = {
  item: ArchiveItemWithBody;
};

export const getStaticPaths: GetStaticPaths = () =>
  archiveItems
    .filter(
      (item) =>
        item.visibility === "public" || item.visibility === "public-anonymized",
    )
    .map((item) => ({
      params: { slug: item.id },
      props: { item },
    }));

const { item } = Astro.props as Props;

const typeLabels: Record<ArchiveType, string> = {
  project: "项目",
  experience: "经历",
  hackathon: "黑客松",
  creation: "创作",
};

const statusLabels = {
  active: "进行中",
  completed: "已完成",
  archived: "已归档",
  paused: "暂停",
  draft: "草稿",
} as const;

const visibilityLabels = {
  public: "公开",
  "public-anonymized": "匿名公开",
  private: "私有",
} as const;

const evidenceKindLabels: Record<ArchiveEvidence["kind"], string> = {
  "public-link": "公开链接",
  "local-file": "本地文件",
  screenshot: "截图",
  "source-record": "来源记录",
  "user-confirmation": "用户确认",
};

const visibleEvidence = item.evidence.filter(
  (evidence) =>
    evidence.visibility === undefined ||
    evidence.visibility === "public" ||
    evidence.visibility === "public-anonymized",
);

const formatPeriod = (start: string, end?: string) =>
  start.replaceAll("-", ".") + (end ? " — " + end.replaceAll("-", ".") : "");
---

<BaseLayout
  title={item.title}
  description={item.summary}
>
  <div class="archive-detail-page">
    <div class="archive-detail-shell">
      <a class="archive-detail-back" href="/archive/">← 返回档案库</a>

      <header class="archive-detail-header">
        <div class="archive-detail-kicker">
          <span>{String(item.order ?? 0).padStart(2, "0")}</span>
          <span>{typeLabels[item.type]}</span>
          <span>{statusLabels[item.status]}</span>
        </div>
        <h1>{item.title}</h1>
        <p class="archive-detail-summary">{item.summary}</p>
        <dl class="archive-detail-meta">
          <div>
            <dt>时间</dt>
            <dd>{formatPeriod(item.period.start, item.period.end)}</dd>
          </div>
          <div>
            <dt>角色</dt>
            <dd>{item.role}</dd>
          </div>
          <div>
            <dt>公开范围</dt>
            <dd>{visibilityLabels[item.visibility]}</dd>
          </div>
        </dl>
      </header>

      <div class="archive-detail-grid">
        <section class="archive-detail-body" aria-labelledby="archive-detail-work-title">
          <p class="archive-detail-label">我的贡献</p>
          <h2 id="archive-detail-work-title">我做了什么</h2>
          {item.cover && item.cover.position !== "after" ? (
            <figure class="archive-detail-cover">
              <img src={item.cover.src} alt={item.cover.alt} />
            </figure>
          ) : null}
          <ul>
            {item.contributions.map((contribution) => <li>{contribution}</li>)}
          </ul>
          {item.cover && item.cover.position === "after" ? (
            <figure
              class:list={[
                "archive-detail-cover",
                item.cover.fit === "contain" && "archive-detail-cover--contain",
              ]}
            >
              <img src={item.cover.src} alt={item.cover.alt} />
            </figure>
          ) : null}
        </section>

        <aside class="archive-detail-aside">
          <section>
            <p class="archive-detail-label">结果</p>
            <ul>
              {item.outcomes.map((outcome) => <li>{outcome}</li>)}
            </ul>
          </section>

          <section>
            <p class="archive-detail-label">公开边界</p>
            <p>本页只展示已标记为公开或匿名公开的内容；待公开材料不会在这里展开。</p>
          </section>
        </aside>
      </div>

      <section class="archive-detail-section" aria-labelledby="archive-detail-evidence-title">
        <p class="archive-detail-label">证据</p>
        <h2 id="archive-detail-evidence-title">可核验的公开入口</h2>
        {visibleEvidence.length > 0 ? (
          <ul class="archive-detail-evidence-list">
            {visibleEvidence.map((evidence) => (
              <li>
                <div class="archive-detail-evidence-heading">
                  <span class="archive-detail-evidence-kind">
                    {evidenceKindLabels[evidence.kind]}
                  </span>
                {evidence.url && evidence.kind === "screenshot" ? (
                  <button
                    class="archive-detail-evidence-trigger"
                    type="button"
                    data-evidence-image={evidence.url}
                    data-evidence-label={evidence.label}
                    aria-haspopup="dialog"
                  >
                    {evidence.label} <span aria-hidden="true">↗</span>
                  </button>
                ) : evidence.url ? (
                  <a href={evidence.url} target="_blank" rel="noreferrer">
                    {evidence.label} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <strong>{evidence.label}</strong>
                )}
                </div>
                <p>{evidence.supports}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="archive-detail-muted">公开证据正在整理。</p>
        )}
      </section>

      <dialog
        class="archive-evidence-dialog"
        data-evidence-dialog
        aria-labelledby="archive-evidence-dialog-title"
      >
        <div class="archive-evidence-dialog-inner">
          <header class="archive-evidence-dialog-header">
            <div>
              <p class="archive-detail-label">证据预览</p>
              <h2 id="archive-evidence-dialog-title" data-evidence-dialog-title>
                平台数据截图
              </h2>
            </div>
            <button
              class="archive-evidence-dialog-close"
              type="button"
              data-evidence-close
              aria-label="关闭证据预览"
            >
              ×
            </button>
          </header>

          <div class="archive-evidence-dialog-viewport" data-evidence-viewport>
            <img data-evidence-preview alt="" />
          </div>

          <footer class="archive-evidence-dialog-controls" aria-label="图片缩放控制">
            <button type="button" data-evidence-zoom-out aria-label="缩小">−</button>
            <span data-evidence-zoom-level>100%</span>
            <button type="button" data-evidence-zoom-in aria-label="放大">＋</button>
            <button type="button" data-evidence-zoom-reset>恢复</button>
          </footer>
        </div>
      </dialog>

      <nav class="archive-detail-end-nav" aria-label="详情导航">
        <a class="archive-detail-end-link" href="/archive/">
          <span aria-hidden="true">←</span>
          <span>返回档案库</span>
        </a>
      </nav>
    </div>
  </div>
</BaseLayout>

<script>
  const setupEvidenceDialog = () => {
    const dialog = document.querySelector("[data-evidence-dialog]");
    const preview = dialog?.querySelector("[data-evidence-preview]");
    const title = dialog?.querySelector("[data-evidence-dialog-title]");
    const zoomLevel = dialog?.querySelector("[data-evidence-zoom-level]");
    const closeButton = dialog?.querySelector("[data-evidence-close]");
    const zoomOut = dialog?.querySelector("[data-evidence-zoom-out]");
    const zoomIn = dialog?.querySelector("[data-evidence-zoom-in]");
    const zoomReset = dialog?.querySelector("[data-evidence-zoom-reset]");

    if (
      !(dialog instanceof HTMLDialogElement) ||
      !(preview instanceof HTMLImageElement) ||
      !(title instanceof HTMLElement) ||
      !(zoomLevel instanceof HTMLElement)
    ) {
      return;
    }

    let scale = 1;
    const clampScale = (value: number) => Math.min(3, Math.max(0.5, value));
    const applyScale = (value: number) => {
      scale = clampScale(value);
      preview.style.transform = `scale(${scale})`;
      zoomLevel.textContent = `${Math.round(scale * 100)}%`;
    };

    document.querySelectorAll("[data-evidence-image]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const imageUrl = trigger.getAttribute("data-evidence-image");
        const imageLabel = trigger.getAttribute("data-evidence-label") || "平台数据截图";

        if (!imageUrl) return;

        preview.src = imageUrl;
        preview.alt = imageLabel;
        title.textContent = imageLabel;
        applyScale(1);
        dialog.showModal();
      });
    });

    closeButton?.addEventListener("click", () => dialog.close());
    zoomOut?.addEventListener("click", () => applyScale(scale - 0.25));
    zoomIn?.addEventListener("click", () => applyScale(scale + 0.25));
    zoomReset?.addEventListener("click", () => applyScale(1));
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  };

  setupEvidenceDialog();
</script>
