---
import type { Work } from "@/data/site";

type Props = {
  work: Work;
};

const { work } = Astro.props;
const isReady = work.status === "ready";
const isExternal = work.url.startsWith("http");
---

<article class="work-card">
  {work.cover && <img class:list={["work-cover", work.coverMode === "contain" && "contain"]} src={work.cover} alt={`${work.title} 封面`} loading="lazy" />}
  <div>
    <h3>{work.title}</h3>
    <p class="meta">{work.platform} · {work.date}</p>
  </div>
  <ul class="metric-list" aria-label="作品数据">
    {work.metrics.map((metric) => <li>{metric}</li>)}
  </ul>
  <p class="reflection">{work.reflection}</p>
  <a
    class:list={["button", !isReady && "disabled"]}
    href={work.url}
    aria-disabled={!isReady}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noreferrer" : undefined}
  >
    {isReady ? "查看作品" : "链接待补充"}
  </a>
</article>
