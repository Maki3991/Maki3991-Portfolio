---
import type { Project } from "@/data/site";

type Props = {
  project: Project;
  compact?: boolean;
};

const { project, compact = false } = Astro.props;
---

<article class:list={["project-card", compact && "compact"]}>
  <h3>{project.title}</h3>
  <p>{project.summary}</p>
  <p class="role">{project.role}</p>
  <ul class="pill-list" aria-label="关键成果">
    {project.results.map((result) => <li>{result}</li>)}
  </ul>
  <a class="text-link" href={`/projects/#${project.slug}`}>查看详情</a>
</article>
